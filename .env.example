DJANGO_SECRET_KEY=replace-with-a-random-secret
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Set POSTGRES_DB to enable PostgreSQL (SQLite is used for initial local setup).
# POSTGRES_DB=railflow
# POSTGRES_USER=postgres
# POSTGRES_PASSWORD=
# POSTGRES_HOST=localhost
# POSTGRES_PORT=5432

# Paystack TEST mode only. Never commit actual keys to GitHub.
PAYSTACK_TEST_SECRET_KEY=sk_test_replace_with_your_test_secret
# Optional new webhook signing secret (whsec_...); legacy signature also supported.
PAYSTACK_WEBHOOK_SECRET=
